{
  "name": "analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm run build:scripts",
    "build:scripts": "node scripts/build-scripts.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "job:snapshot": "tsx --env-file-if-exists=.env.local scripts/jobs/nightly-snapshot.ts",
    "ci:quality": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run format:check && pnpm run build",
    "auth:schema": "pnpm dlx auth@1.7.5 generate --config scripts/auth-schema.config.ts --output src/db/auth-schema.ts --yes && prettier --write src/db/auth-schema.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "better-auth": "1.7.5",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.28.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.13.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "railway": "3.11.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "5.0.1"
  }
}
