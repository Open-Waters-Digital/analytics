# Environment template. Copy to a local dotenv file (.env.local) for
# development. Every variable the app reads is listed with a safe placeholder;
# production values live in Railway.

# Postgres connection string. Matches compose.yaml for local development.
DATABASE_URL=postgres://analytics:analytics@localhost:5433/analytics

# Generate with: openssl rand -base64 32
#BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
#RESEND_API_KEY=
AUTH_EMAIL_FROM="Open Waters Analytics <analytics@openwaters.digital>"
AUTH_ALLOWED_EMAILS=dev@openwaters.digital

# Installs @open-waters-digital/analytics from GitHub Packages (see .npmrc).
# A classic GitHub token with read:packages only. Needed at install time, so in
# your shell, in CI as a repository secret, and on Railway as a build argument.
#NODE_AUTH_TOKEN=

# Search Console and Bing Webmaster Tools. Leave unset and each engine is
# dormant. The Google value is the service account's JSON key file, base64:
#   base64 -i key.json | tr -d '\n'
# The Bing value is the API key from the Open Waters Bing account's settings.
#GOOGLE_SERVICE_ACCOUNT_KEY=
#BING_WEBMASTER_API_KEY=
