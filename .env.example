# Environment template. Copy to a local dotenv file (.env.local) for
# development. Every variable the app reads is listed with a safe placeholder;
# production values live in Railway.

# Postgres connection string. Matches compose.yaml for local development.
DATABASE_URL=postgres://analytics:analytics@localhost:5433/analytics

# BETTER_AUTH_SECRET= # starts AvKkj8
BETTER_AUTH_URL=http://localhost:3000
#RESEND_API_KEY= # starts re_FNywt
AUTH_EMAIL_FROM="Open Waters Analytics <analytics@openwaters.digital>"
AUTH_ALLOWED_EMAILS=dev@openwaters.digital
